<div class="store-container">
  <h1>Checkout</h1>
  <h2>Order Summary</h2>

  <% @products.each do |product| %>
    <p>
      <%= product.name %> × <%= (session[:cart] || {})[product.id.to_s] %>
      — <%= number_to_currency(product.current_price * (session[:cart] || {})[product.id.to_s].to_i) %>
    </p>
  <% end %>

  <p>Subtotal: <%= number_to_currency(@subtotal) %></p>
  <p>GST + Manitoba PST (12%): <%= number_to_currency(@tax) %></p>
  <h2>Total: <%= number_to_currency(@total) %></h2>

  <%= form_with url: checkout_path, method: :post do |f| %>
    <p><%= f.label :customer_name, "Full Name" %><br>
    <%= f.text_field :customer_name, required: true %></p>

    <p><%= f.label :email %><br>
    <%= f.email_field :email, required: true %></p>

    <p><%= f.label :address, "Street Address" %><br>
    <%= f.text_area :address, required: true %></p>

    <p><%= f.label :city %><br>
    <%= f.text_field :city, required: true %></p>

    <p><%= f.label :province %><br>
    <%= f.select :province,
      ["Manitoba", "Ontario", "Alberta", "British Columbia", "Saskatchewan",
       "Quebec", "Nova Scotia", "New Brunswick", "Newfoundland and Labrador",
       "Prince Edward Island"], { selected: "Manitoba" }, required: true %></p>

    <p><%= f.label :postal_code, "Postal Code" %><br>
    <%= f.text_field :postal_code, required: true %></p>

    <%= f.submit "Place Order", class: "product-button" %>
  <% end %>
</div>
