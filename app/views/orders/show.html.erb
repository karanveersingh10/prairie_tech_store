<div class="store-container">
  <h1>Thank You for Your Order!</h1>
  <p>Your order has been placed successfully.</p>
  <h2>Order #<%= @order.id %></h2>
  <p><strong>Payment Status:</strong> <%= @order.payment_status %></p>
  <p>Status: <%= @order.status.humanize %></p>
  <p>Customer: <%= @order.customer_name %></p>

  <h3>Items</h3>
  <% @order.order_items.each do |item| %>
    <p><%= item.product.name %> × <%= item.quantity %> —
      <%= number_to_currency(item.unit_price * item.quantity) %></p>
  <% end %>

  <p>Subtotal: <%= number_to_currency(@order.subtotal) %></p>
  <p>Tax: <%= number_to_currency(@order.tax) %></p>
  <h2>Total: <%= number_to_currency(@order.total) %></h2>

  <%= link_to "Continue Shopping", root_path, class: "product-button" %>
</div>
