
<div class="store-container">
  <section class="hero">
    <p class="hero-label">WELCOME TO PRAIRIE TECH STORE</p>
    <h1>Technology for your everyday life.</h1>
    <p>Discover quality laptops, monitors and accessories.</p>
  </section>

  <section class="category-section">
    <h2>Shop by Category</h2>

    <div class="category-list">
      <% @categories.each do |category| %>
        <%= link_to category_path(category), class: "category-card" do %>
          <h3><%= category.name %></h3>
          <p><%= category.description %></p>
          <span>Explore Category →</span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="products-section">
    <h2>Explore Our Products</h2>

    <%= form_with url: products_path, method: :get, local: true,
        class: "search-form" do |form| %>

      <%= form.text_field :search,
          value: params[:search],
          placeholder: "Search products by name, brand or description..." %>

      <%= form.select :category_id,
          options_from_collection_for_select(
            @categories,
            :id,
            :name,
            params[:category_id]
          ),
          { include_blank: "All Categories" } %>

      <%= form.submit "Search", class: "product-button" %>
    <% end %>

    <% if params[:search].present? || params[:category_id].present? %>
      <%= link_to "Clear Search", products_path %>
    <% end %>

    <% if @products.empty? %>
      <p>No products found. Try another search.</p>
    <% end %>

    <div class="product-grid">
      <% @products.each do |product| %>
        <article class="product-card">
          <div class="product-placeholder">
            <span>TECH</span>
          </div>

          <div class="product-info">
            <p class="product-category">
              <%= product.category.name %>
            </p>

            <h3><%= product.name %></h3>

            <p><%= product.description %></p>

            <h4>
              <%= number_to_currency(product.current_price) %>
            </h4>

            <%= link_to "View Details",
                product_path(product),
                class: "product-button" %>
          </div>
        </article>
      <% end %>
    </div>

    <% if @total_pages > 1 %>
      <nav class="pagination" aria-label="Product pages">

        <% if @current_page > 1 %>
          <%= link_to "Previous",
              products_path(request.query_parameters.merge(page: @current_page - 1)),
              class: "pagination-link" %>
        <% end %>

        <% (1..@total_pages).each do |page| %>
          <%= link_to page,
              products_path(request.query_parameters.merge(page: page)),
              class: "pagination-link #{'active' if page == @current_page}" %>
        <% end %>

        <% if @current_page < @total_pages %>
          <%= link_to "Next",
              products_path(request.query_parameters.merge(page: @current_page + 1)),
              class: "pagination-link" %>
        <% end %>

      </nav>
    <% end %>

  </section>
</div>
