<div class="store-container">
  <%= link_to "← Back to Store", root_path, class: "back-link" %>
  <%= link_to "View Shopping Cart", cart_path, class: "back-link" %>

  <div class="product-detail">
    <div class="product-detail-image">
      <% if @product.image.attached? %>
        <%= image_tag @product.image.variant(:large),
            alt: @product.name,
            class: "product-detail-photo" %>
      <% else %>
        <span>PRODUCT IMAGE</span>
      <% end %>
    </div>

    <div class="product-detail-info">
      <p class="product-category"><%= @product.category.name %></p>
      <h1><%= @product.name %></h1>
      <p><strong>Brand:</strong> <%= @product.brand %></p>
      <p><%= @product.description %></p>
      <h2><%= number_to_currency(@product.current_price) %></h2>
      <p><strong>Availability:</strong>
        <%= @product.stock_quantity > 0 ? "In Stock" : "Out of Stock" %>
      </p>
      <p><strong>SKU:</strong> <%= @product.sku %></p>

      <% if @product.active? && @product.stock_quantity > 0 %>
        <%= form_with url: add_to_cart_path(@product), method: :post do |form| %>
          <%= form.label :quantity, "Quantity" %>
          <%= form.number_field :quantity, value: 1, min: 1,
              max: @product.stock_quantity %>
          <%= form.submit "Add to Cart", class: "product-button" %>
        <% end %>
      <% else %>
        <p>Currently unavailable.</p>
      <% end %>

      <%= link_to "Continue Shopping", root_path, class: "product-button" %>
    </div>
  </div>
</div>
